    title: Dataset of breast ultrasound images
    abbreviation: BUSI
    authors:
      - family-names: Al-Dhabyani
        given-names: Walid
      - family-names: Gomaa
        given-names: Mohammed
      - family-names: Khaled
        given-names: Hussien
